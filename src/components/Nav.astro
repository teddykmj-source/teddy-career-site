---
// 떠 있는 유리 알약 내비. 상단에 붙이지 않는다.
import type { SiteContent } from '../data';
import { getRelativeLocaleUrl } from 'astro:i18n';
interface Props { locale: 'ko' | 'en'; content: SiteContent; }
const { locale, content } = Astro.props;
const other = locale === 'ko' ? 'en' : 'ko';
const links = [
  { href: '#cap', label: content.nav.highlights },
  { href: '#work', label: content.nav.automation },
  { href: '#cv', label: content.nav.experience },
];
---
<nav class="nav">
  <span class="nav-brand">{content.fullName.split('·')[0].trim()}</span>
  <div class="nav-links">
    {links.map((l) => <a href={l.href}>{l.label}</a>)}
  </div>
  <a class="nav-lang" href={getRelativeLocaleUrl(other, '')} hreflang={other} aria-label={other === 'en' ? 'English' : '한국어'}>
    {other === 'en' ? 'EN' : 'KO'}
  </a>
  <button class="tog" id="tog" type="button" aria-pressed="false" aria-label="">
    <span class="tog-face" aria-hidden="true"></span>
  </button>
  <a class="btn btn-dark" href="#contact">{content.ctaContact} <span class="ico" aria-hidden="true">↗</span></a>
  <button class="burger" id="burger" aria-expanded="false" aria-controls="menu" aria-label="">
    <span></span><span></span>
  </button>
</nav>
<div class="menu" id="menu">
  {links.map((l) => <a href={l.href}>{l.label}</a>)}
  <a href="#contact">{content.ctaContact}</a>
</div>
