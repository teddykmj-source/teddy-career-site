---
// 경력: 카드 하나 안에서 구분선으로 나눈다.
import type { SiteContent } from '../data';
interface Props { content: SiteContent; }
const { content } = Astro.props;
---
<section class="sec" id="cv" style="padding-top:0">
  <div class="wrap">
    <div class="sec-head rv">
      <span class="pill">{content.experienceTitle}</span>
      <h2 class="h2">{content.headings.experience}</h2>
    </div>
    <div class="rv"><div class="shell"><div class="core core-pad">
      <div class="cv-list">
        {content.experience.map((e) => (
          <div class="cv-row">
            <div class="cv-when">{e.period}</div>
            <div>
              <div class="cv-who">{e.title}{e.current && <span class="cv-now">NOW</span>}</div>
              <p class="cv-what">{e.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div></div></div>
  </div>
</section>
