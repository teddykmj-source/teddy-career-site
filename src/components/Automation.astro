---
// 만들고 있는 시스템: Z축 캐스케이드로 겹쳐 쌓는다.
import type { SiteContent } from '../data';
interface Props { content: SiteContent; }
const { content } = Astro.props;
const photos = ['/teddy-royalty.jpg', '/teddy-invention.jpg', '/teddy-priorart.jpg'];
---
<section class="sec" id="work" style="padding-top:0">
  <div class="wrap">
    <div class="sec-head rv">
      <span class="pill">{content.automationTitle}</span>
      <h2 class="h2">{content.headings.automation}</h2>
      <p class="body">{content.automationLead}</p>
    </div>
    <div class="cascade">
      {content.automation.map((a, i) => (
        <div class={`casc-item casc-${i + 1} rv`}>
          <div class="shell"><div class="core core-pad"><div class="work">
            <figure class="work-fig">
              <img src={photos[i % photos.length]} alt={a.title} loading="lazy" width="1400" height="875" />
            </figure>
            <div>
              <p class="work-meta" data-count>{a.status}</p>
              <h3 class="h3" style="margin-top:12px">{a.title}</h3>
              <p class="body" style="margin-top:14px">{a.description}</p>
              <ol class="flow">
                {a.flow.nodes.map((n, k) => (
                  <li class={`flow-n${a.flow.hold === k ? ' flow-hold' : ''}`}
                      style={`--d:${k * 420 + (k > a.flow.hold ? 500 : 0)}ms`}>{n}</li>
                ))}
              </ol>
            </div>
          </div></div></div>
        </div>
      ))}
    </div>
  </div>
</section>
