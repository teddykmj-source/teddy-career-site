---
// 메인에는 IP·기술가치평가 그룹만 요약하고 전체는 별도 페이지로 넘긴다.
import type { SiteContent } from '../data';
import { getCertifications } from '../data';
import { getRelativeLocaleUrl } from 'astro:i18n';
interface Props { locale: 'ko' | 'en'; content: SiteContent; }
const { locale, content } = Astro.props;
const primary = getCertifications(locale).find((g) => g.tone === 'primary');
---
<section class="sec" id="cert" style="padding-top:0">
  <div class="wrap">
    <div class="sec-head rv">
      <span class="pill">{content.certificationsTitle}</span>
      <h2 class="h2">{content.headings.certifications}</h2>
    </div>
    <div class="rv"><div class="shell"><div class="core core-pad">
      <div class="log-k">{primary?.title}</div>
      {primary?.items.map((c) => (
        <div class="log-r"><time>{c.date}</time><p>{c.name} <span class="cert-issuer">{c.issuer}</span></p></div>
      ))}
      <a class="more" href={getRelativeLocaleUrl(locale, 'certifications/')}>
        {content.certViewAll.replace('→', '').trim()} <span class="ico" aria-hidden="true">↗</span>
      </a>
    </div></div></div>
  </div>
</section>
