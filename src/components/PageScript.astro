---
// 진입 애니메이션 · 테마 토글 · 햄버거 · Formspree 전송. 페이지마다 한 번만 넣는다.
---
<script is:inline>
(function () {
  var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var rv = document.querySelectorAll('.rv');
  if (reduce || !('IntersectionObserver' in window)) {
    rv.forEach(function (el) { el.classList.add('in'); });
  } else {
    var io = new IntersectionObserver(function (es) {
      es.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
    }, { threshold: 0.12, rootMargin: '0px 0px -7% 0px' });
    rv.forEach(function (el, i) { el.style.transitionDelay = (i % 3) * 90 + 'ms'; io.observe(el); });
  }

  var root = document.documentElement;
  var tog = document.getElementById('tog');
  var mq = window.matchMedia('(prefers-color-scheme: dark)');
  var L = root.lang === 'en'
    ? { toDark: 'Switch to dark theme', toLight: 'Switch to light theme', menu: 'Open menu', close: 'Close menu' }
    : { toDark: '어두운 테마로 전환', toLight: '밝은 테마로 전환', menu: '메뉴 열기', close: '메뉴 닫기' };
  function stored() { try { var t = localStorage.getItem('theme'); return (t === 'dark' || t === 'light') ? t : null; } catch (e) { return null; } }
  function effective() { return stored() || (mq.matches ? 'dark' : 'light'); }
  function paint() {
    if (!tog) return;
    var dark = effective() === 'dark';
    tog.setAttribute('aria-pressed', String(dark));
    tog.setAttribute('aria-label', dark ? L.toLight : L.toDark);
  }
  if (tog) {
    tog.addEventListener('click', function () {
      var next = effective() === 'dark' ? 'light' : 'dark';
      root.setAttribute('data-theme', next);
      try { localStorage.setItem('theme', next); } catch (e) {}
      paint();
    });
    mq.addEventListener('change', function () { if (!stored()) paint(); });
    paint();
  }

  var burger = document.getElementById('burger');
  var menu = document.getElementById('menu');
  if (burger && menu) {
    var setMenu = function (open) {
      burger.setAttribute('aria-expanded', String(open));
      burger.setAttribute('aria-label', open ? L.close : L.menu);
      menu.classList.toggle('open', open);
      document.body.style.overflow = open ? 'hidden' : '';
    };
    setMenu(false);
    burger.addEventListener('click', function () { setMenu(burger.getAttribute('aria-expanded') !== 'true'); });
    menu.addEventListener('click', function (e) { if (e.target.tagName === 'A') setMenu(false); });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && menu.classList.contains('open')) { setMenu(false); burger.focus(); }
    });
  }

  var form = document.getElementById('cform');
  if (!form) return;
  var okBox = document.getElementById('fok');
  var btn = document.getElementById('fbtn');
  var ferr = document.getElementById('ferr');
  var d = form.dataset;
  var rules = [
    { id: 'f-name', err: 'e-name', test: function (v) { return v.length > 0; }, msg: d.errName },
    { id: 'f-mail', err: 'e-mail', test: function (v) { return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v); }, msg: d.errEmail },
    { id: 'f-msg', err: 'e-msg', test: function (v) { return v.length >= 10; }, msg: d.errMessage }
  ];
  function check(r) {
    var input = document.getElementById(r.id), slot = document.getElementById(r.err);
    var pass = r.test(input.value.trim());
    input.setAttribute('aria-invalid', pass ? 'false' : 'true');
    slot.textContent = pass ? '' : r.msg;
    return pass;
  }
  rules.forEach(function (r) {
    document.getElementById(r.id).addEventListener('blur', function () {
      if (document.getElementById(r.id).value.trim()) check(r);
    });
  });
  function restore() { btn.removeAttribute('aria-busy'); btn.firstChild.textContent = d.submit + ' '; }
  form.addEventListener('submit', function (e) {
    e.preventDefault();
    if (!rules.map(check).every(Boolean)) {
      var bad = form.querySelector('[aria-invalid="true"]'); if (bad) bad.focus(); return;
    }
    ferr.textContent = '';
    btn.setAttribute('aria-busy', 'true');
    btn.firstChild.textContent = d.sending + ' ';
    fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } })
      .then(function (res) {
        if (res.ok) { form.style.display = 'none'; okBox.style.display = 'block'; return; }
        return res.json().then(function (j) {
          var m = (j && j.errors) ? j.errors.map(function (x) { return x.message; }).filter(Boolean) : [];
          ferr.textContent = m.length ? d.errSend + ' (' + m.join(' ') + ')' : d.errSend;
          restore();
        }, function () { ferr.textContent = d.errSend; restore(); });
      })
      .catch(function () { ferr.textContent = d.errNetwork; restore(); });
  });
})();
</script>
