---
// 히어로: 비대칭 분할 + Z축 캐스케이드(사진 카드 위에 사양 카드가 겹친다)
import type { SiteContent } from '../data';
import { Picture } from 'astro:assets';
import photo from '../assets/teddy-photo.jpg';
import { splitWords } from '../motion/words';
interface Props { content: SiteContent; }
const { content } = Astro.props;
let wi = 0;
const lines = content.headline.map((line) => splitWords(line).map((w) => ({ w, i: wi++ })));
---
<section class="hero">
<svg class="hero-net" viewBox="0 0 800 600" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
  <g class="net-lines">
    <path pathLength="1" d="M80 120 L300 220 L520 160 L720 300" />
    <path pathLength="1" d="M300 220 L260 420 L540 480" />
    <path pathLength="1" d="M520 160 L540 480" />
  </g>
  <g class="net-nodes">
    <circle cx="80" cy="120" r="3" /><circle cx="300" cy="220" r="3" /><circle cx="520" cy="160" r="3" />
    <circle cx="720" cy="300" r="3" /><circle cx="260" cy="420" r="3" /><circle cx="540" cy="480" r="3" />
  </g>
</svg>
  <div class="wrap hero-grid">
    <div>
      <span class="pill">{content.eyebrow}</span>
      <h1 class="h1">
        {lines.map((words, li) => (
          <>
            {li > 0 && <>{' '}<br /></>}
            {words.map(({ w, i }, k) => (
              <>{k > 0 && ' '}<span class="w" style={`--i:${i}`}>{w}</span></>
            ))}
          </>
        ))}
      </h1>
      <p class="lead">{content.tagline}</p>
      <div class="hero-cta">
        <a class="btn btn-dark" href="#cap">{content.nav.highlights} <span class="ico" aria-hidden="true">↗</span></a>
        <a class="btn btn-soft" href="/deck/">{content.ctaDeck} <span class="ico" aria-hidden="true">→</span></a>
      </div>
    </div>
    <div class="stack rv">
      <div class="stack-a tilt-l">
        <div class="shell"><div class="core">
          <figure class="figbox" style="aspect-ratio:4/4.4">
            <Picture src={photo} formats={['avif', 'webp']} widths={[480, 720, 893]} sizes="(min-width: 1000px) 32vw, 100vw" alt={content.fullName} loading="eager" fetchpriority="high" />
          </figure>
        </div></div>
      </div>
      <div class="stack-b tilt-r">
        <div class="shell"><div class="core core-pad">
          <dl class="spec">
            {content.heroSpecs.map((s) => <div><dt>{s.label}</dt><dd>{s.value}</dd></div>)}
          </dl>
        </div></div>
      </div>
    </div>
  </div>
</section>
