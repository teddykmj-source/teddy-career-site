---
// 지표 4개. 자격증 항목만 별도 페이지로 연결된다.
import type { SiteContent } from '../data';
interface Props { content: SiteContent; }
const { content } = Astro.props;
---
<section class="wrap" style="padding-bottom:var(--sec)">
  <div class="stats stats-4">
    {content.stats.map((s) => (
      <div class="rv"><div class="shell"><div class="core core-pad">
        <div class="num stat-n"><span class="sr">{s.value}</span><span aria-hidden="true" data-count>{s.value}</span></div>
        <p class="stat-l">{s.href ? <a class="stat-link" href={s.href}>{s.label} <span aria-hidden="true">↗</span></a> : s.label}</p>
      </div></div></div>
    ))}
  </div>
</section>
