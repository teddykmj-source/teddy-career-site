---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
import PageScript from '../../../components/PageScript.astro';
import { getContent, getCertifications, getTraining } from '../../../data';
const locale = 'en' as 'ko' | 'en';
const content = getContent(locale);
const groups = getCertifications(locale);
const training = getTraining(locale);
const trainingTitle = locale === 'ko' ? '교육 수료' : 'Training';
const backLabel = locale === 'ko' ? '돌아가기' : 'Back';
---
<BaseLayout lang="en" title="Certifications · Teddy" description={content.tagline} pathKey="certifications/">
  <Nav locale={locale} content={content} />
  <main id="top" tabindex="-1">
    <section class="sec sec-top">
      <div class="wrap">
        <div class="sec-head rv">
          <span class="pill">{content.certificationsTitle}</span>
          <h2 class="h2">{content.headings.certifications}</h2>
        </div>
        <div class="logs">
          {groups.map((g) => (
            <div class="rv"><div class="shell"><div class="core core-pad">
              <div class="log-k">{g.title}</div>
              {g.items.map((c) => (
                <div class="log-r"><time>{c.date}</time><p>{c.name} <span class="cert-issuer">{c.issuer}</span></p></div>
              ))}
            </div></div></div>
          ))}
        </div>
        <div class="logs" style="margin-top:clamp(18px,2.2vw,26px)">
          <div class="rv"><div class="shell"><div class="core core-pad">
            <div class="log-k">{trainingTitle}</div>
            {training.map((t) => (
              <div class="log-r"><time>{t.year}</time><p>{t.title}</p></div>
            ))}
          </div></div></div>
        </div>
        <p style="margin-top:clamp(26px,3vw,40px)">
          <a class="btn btn-soft" href={locale === 'ko' ? '/' : '/en/'}><span class="ico" aria-hidden="true">←</span> {backLabel}</a>
        </p>
      </div>
    </section>
  </main>
  <Footer content={content} />
  <PageScript />
</BaseLayout>
